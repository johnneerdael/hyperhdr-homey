{
  "id": "hyperhdr",
  "name": { "en": "HyperHDR Instance" },
  "class": "light",
  "capabilities": [
    "onoff",
    "dim",
    "light_hue",
    "light_saturation",
    "light_mode",
    "hyperhdr_effect"
  ],
  "images": {
    "small": "/drivers/hyperhdr/assets/icon.svg",
    "large": "/drivers/hyperhdr/assets/icon.svg"
  },
  "platforms": ["local"],
  "connectivity": ["lan"],
  "discovery": "hyperhdr",
  "pair": [
    { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } },
    { "id": "add_devices", "template": "add_devices" },
    { "id": "manual" },
    { "id": "auth" }
  ],
  "settings": [
    {
      "id": "host",
      "type": "text",
      "label": { "en": "Host" }
    },
    {
      "id": "port",
      "type": "number",
      "label": { "en": "Port" },
      "value": 8090
    },
    {
      "id": "priority",
      "type": "number",
      "label": { "en": "Priority (1-253)" },
      "value": 128,
      "min": 1,
      "max": 253
    },
    {
      "id": "origin",
      "type": "text",
      "label": { "en": "Origin label" },
      "value": "Homey"
    }
  ]
}
